# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Any model on your account that supports structured outputs.
OPENAI_MODEL=gpt-4.1-mini
# Set to 0 to run fully deterministic (template narratives, no API calls).
MVA_USE_LLM=1
# Where validation runs (results.json, summary.md, audit.jsonl) are written.
MVA_RUNS_DIR=runs
